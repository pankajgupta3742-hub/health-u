{
  "version": "2.0.0",
  "inputs": [],
  "tasks": [
    {
      "label": "0. Set up everything (first time only)",
      "type": "shell",
      "command": "python3 scripts/setup.py",
      "windows": { "command": "py -3 scripts\\setup.py" },
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "1. Setup backend (create .venv and install packages)",
      "type": "shell",
      "command": "python3 scripts/setup.py --skip-node",
      "windows": { "command": "py -3 scripts\\setup.py --skip-node" },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "2. Setup frontend (npm install)",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Start API (backend, port 8000)",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "windows": {
        "command": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000"
      },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "health-u" },
      "problemMatcher": []
    },
    {
      "label": "Start web app (frontend, port 3015)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "health-u" },
      "problemMatcher": []
    },
    {
      "label": "Run Health-U (API + web app)",
      "dependsOn": [
        "Start API (backend, port 8000)",
        "Start web app (frontend, port 3015)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Run backend tests (pytest)",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "windows": { "command": ".\\.venv\\Scripts\\python.exe -m pytest -q" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build frontend (type-check + production build)",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}

# Copy to backend/.env on your own machine and fill in real values. Never commit backend/.env.

# Required in production. Long random string used to sign login tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# Database. SQLite is used when this is unset. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/healthu

# Comma-separated list of frontend origins allowed by CORS. Use your real frontend URL in production.
CORS_ORIGINS=http://localhost:3015,http://localhost:5173

# Google Gemini API key (free tier available): https://aistudio.google.com/apikey
# Leave blank until you have a key. Without it the chatbot shows a setup message.
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional limits
# TOKEN_TTL_MINUTES=1440
# MAX_UPLOAD_BYTES=5242880
